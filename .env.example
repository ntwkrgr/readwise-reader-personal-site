READWISE_TOKEN=your_readwise_access_token_here
SECRET_KEY=any_random_string_here
PORT=5555
# Optional: diskcache location and TTLs
# CACHE_DIR=/path/to/cache
# LIST_CACHE_TTL=1200
# ARTICLE_CACHE_TTL=3600
# Optional: host folder bind-mounted to /app/notes, where journal-*.txt and
# thing-*.txt files are written. Defaults to ./notes if unset.
# NOTES_HOST_DIR=/path/to/notes
# Optional: override the in-container notes path or the timezone used for
# note filename timestamps (defaults to America/Chicago).
# NOTES_DIR=/app/notes
# NOTES_TZ=America/Chicago
